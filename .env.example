# Copy this file to .env and fill in real values from your Supabase project
# (Project Settings -> API). Never commit .env.
#
# Every Supabase-backed feature (live reactions, song requests, guestbook,
# real listener presence) works without these set — it just falls back to a
# clearly-labeled local/demo mode. Only the ANON key belongs here; never put
# the service_role key in a frontend-readable file.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
